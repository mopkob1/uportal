{
  "about": "Create or update a runtime template set with multiple files",
  "uri": "/templates/upsert",
  "method": "POST",
  "auth": "X-Token:CHANGE_ME_UPORTAL_ADMIN_SECRET",
  "ttl": "60s",
  "error": 500,
  "body": {
    "template_set": "",
    "files_b64": ""
  },
  "script": [
    "bash",
    "/usr/local/bin/uportal-template-upsert.sh",
    "{template_set}",
    "{files_b64}"
  ]
}
